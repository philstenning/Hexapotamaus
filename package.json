{
  "name": "hexapotamaus",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "verify": "pnpm install && pnpm typecheck && pnpm test",
    "sim": "node packages/sim/src/cli.ts",
    "brain": "node packages/brain/src/cli.ts",
    "dashboard": "pnpm --filter @hexapotamaus/dashboard dev"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
